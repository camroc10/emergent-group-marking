    </plot>
    <plot x="770" autoPlotX="true" yMax="1.0" autoPlotY="true" y="15" xMin="0.0" height="300" legend="false" xMax="10.0" yMin="0.0" width="335" display="js divergence (per feature)">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-2674135" legend="true">
        <setup></setup>
        <update>plot min-feature-js 0 1</update>
      </pen>
      <pen interval="1.0" mode="0" display="pen-1" color="-1184463" legend="true">
        <setup></setup>
