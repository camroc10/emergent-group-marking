  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="model variants" repetitions="10" sequentialRunOrder="false" runMetricsEveryStep="false" timeLimit="3000">
      <setup>setup</setup>
      <go>go</go>
      <runMetricsCondition>ticks = 3000 - ticks-recorded</runMetricsCondition>
      <metrics>
        <metric>mean-js-final</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="model-variant">
          <value value="0"></value>
          <value value="2"></value>
