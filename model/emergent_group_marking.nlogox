    <plot x="400" autoPlotX="true" yMax="1.0" autoPlotY="true" y="150" xMin="0.0" height="190" legend="true" xMax="10.0" yMin="0.0" width="175" display="decision success">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="in-group" color="-2674135" legend="true">
        <setup></setup>
        <update>plot success-ingroup</update>
      </pen>
      <pen interval="1.0" mode="0" display="out-group" color="-13345367" legend="true">
        <setup></setup>
        <update>plot success-outgroup</update>
      </pen>
      <pen interval="1.0" mode="0" display="overall success" color="-10899396" legend="true">
        <setup></setup>
        <update>plot success-overall</update>
      </pen>
    </plot>
    <slider x="15" step="1" y="245" max="20" width="250" display="decision-steepness" height="50" min="0" direction="Horizontal" default="15.0" variable="decision-steepness"></slider>
    <slider x="15" step="10" y="70" max="200" width="250" display="pop-size" height="50" min="0" direction="Horizontal" default="100.0" variable="pop-size"></slider>
    <plot x="770" autoPlotX="true" yMax="1.0" autoPlotY="true" y="320" xMin="0.0" height="280" legend="false" xMax="10.0" yMin="0.0" width="345" display="js divergence (global)">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
