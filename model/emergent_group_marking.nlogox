<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[;; Model: Emergent Group Marking 
;; Version: 3.1.0
;; Author: Cormac Moran

;; Requirements:
;; - NetLogo 7.0.3
;; - Extensions: array

extensions [array]

globals [
  ;; Population/network variables
  ;pop-size                   ;; Slider
  num-groups        
  ;social-memory-size         ;; Slider
  ;p-outgroup                 ;; Slider

  ;; Language model
  num-features
  num-variants
  variants
  
  ;; Interaction dynamics
  interaction-rounds
  p-observe
  inference-cost
  ;decision-steepness         ;; Slider
  
  ;; Payoff structure
  payoff                     
  penalty
  
  ;; Social learning/language change
  social-learning-rate
  noise-rate
  diffusion-rate
  
  ;; Metrics (per tick)
  tick-interactions
  tick-ingroup
  coop
  defect
  coop-ingroup
  coop-outgroup
  defect-ingroup
  defect-outgroup
  signal-success
  used-inference
  stranger-partner
  
  ;; Metrics (BehaviorSpace)
  inference-history
  js-history
  risk-perception-history
  min-js-history
  median-js-history
  max-js-history
  
  ;; Helper variables
  group-language-counts
  group-agentsets
  
  ;; BehaviorSpace setup
  ;model-variant
  ;time-series?
  ;ticks-recorded
]

turtles-own [
  group-id
  language
  known-partners 
  belief-counts 
  fitness
  
  alpha-ingroup
  beta-ingroup
  alpha-stranger
  beta-stranger
  
  p-ingroup-est
  p-stranger-est           
  
  risk-perception
]

;;;;;;;;;;;;;;;;;;;;;;;;
;;; Setup Procedures ;;;
;;;;;;;;;;;;;;;;;;;;;;;;

to setup
  clear-all
  
  no-display
  
  setup-variables
  
  create-population
  
  setup-known-partners
  
  reset-ticks
end

to setup-variables
  ;; Population/network variables
  set num-groups 2
  
  ;; Language model
  set num-features 3
  set num-variants 3
  set variants n-values num-variants [i -> i + 1]
  
  ;; Interaction dynamics
  set interaction-rounds 3
  set p-observe 0.2
  set inference-cost 0.3
  
  ;; Payoff structure
  set payoff 1
  set penalty 1
  
  ;; Social learning/language change
  set social-learning-rate 0.05
  set noise-rate 0.33
  set diffusion-rate 0.001
  
  ;; Metrics (BehaviorSpace)
  set inference-history []
  set js-history []
  set risk-perception-history []
  set min-js-history []
  set median-js-history []
  set max-js-history []
  
  ;; Helper variables
  let total-lang-size (num-groups * num-features * num-variants)
  set group-language-counts array:from-list n-values total-lang-size [0]
end

to create-population
  create-turtles pop-size [
    ;; Basic variables
    set fitness 0
    set known-partners no-turtles
    
    ;; Assign group
    set group-id floor (who / (pop-size / num-groups))
    
    set language n-values num-features [
      one-of variants
    ]
    
    ;; Initilise Bayesian belief counts
    set belief-counts new-belief-array
    
    ;; Initialise Beta priors for partner--group estimates
    set alpha-ingroup 1
    set beta-ingroup 1
    set alpha-stranger 1
    set beta-stranger 1
    
    set p-ingroup-est 0.001
    set p-stranger-est 0.001
    
    set risk-perception 0
  ]
  
  ;; After creating turtles, group them by group into an agentset
  set group-agentsets n-values num-groups [ g -> turtles with [group-id = g] ]
end

to setup-known-partners
  ask turtles [
    let my-group group-id
    
    set known-partners n-of 1 other (item my-group group-agentsets)
    
    ask known-partners [
      set known-partners (turtle-set known-partners myself)
    ]
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Runtime Procedures ;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;

to go  
  reset-metrics
  
  ask turtles [
    
    repeat interaction-rounds [
      run-interaction
    ]
  ]
  
  run-social-learning
  
  ask turtles [
    set fitness (fitness * 0.95)
  ]
  
  ;; Update metric array
  update-language-counts
  
  if not time-series? [
    if ticks > 2000 [
      record-metrics
    ]
  ]
  
  tick
end

to reset-metrics
  set tick-interactions 0
  set tick-ingroup 0
  set coop 0
  set defect 0
  set coop-ingroup 0
  set coop-outgroup 0
  set defect-ingroup 0
  set defect-outgroup 0
  set signal-success 0
  set used-inference 0
  set stranger-partner 0
end

to record-metrics
  ;; General metrics
  set inference-history lput proportion-inference inference-history
  set js-history lput between-group-js js-history
  set risk-perception-history lput mean-risk-perception risk-perception-history
  
  ;; Linguistic metrics
  set min-js-history lput (min-feature-js 0 1) min-js-history
  set median-js-history lput (median-feature-js 0 1) median-js-history
  set max-js-history lput (max-feature-js 0 1) max-js-history
end
  

;;;;;;;;
;;;;;;;;;;;;;;;; Interaction
;;;;;;;;

to run-interaction
  ;; Select a partner 
  let partner select-partner
  
  if partner != nobody [
    set tick-interactions tick-interactions + 1 ;; Metric
    
    ;; Produce signals
    let my-signal language
    let partner-signal [language] of partner
    
    ;; Decide to cooperate based on different strategies
    let i-cooperated? should-cooperate? partner partner-signal
    ifelse i-cooperated? [
      set coop coop + 1 ;; Metric
    ][
      set defect defect + 1 ;; Metric
    ]
    
    ;; Partner decision
    let partner-cooperated? [should-cooperate? myself my-signal] of partner
    
    let partner-group [group-id] of partner
    let same-group? partner-group = group-id
    
    ;; Apply decision outcomes (discrimination success)
    apply-decision-outcomes partner i-cooperated? same-group?
    
    if same-group? [
      set tick-ingroup tick-ingroup + 1 ;; Metric
      ;; Apply partner decision outcomes (my signalling success)
      apply-partner-outcomes partner-cooperated?
      
      ;; Add partner to known-partners if both have space
      update-known-partners partner
      
    ]
    
    diffuse-language partner
    
    update-stranger-prior partner
    
    ;; Counts updated via partial observation (interaction success "revealed" occasionally)
    if random-float 1 < p-observe [
      bayesian-update partner-signal partner-group
      
      update-ingroup-prior same-group? partner
    ]
    
    update-risk-perception
  ]
end 

to-report select-partner  
  let my-group group-id
  
  ifelse random-float 1 < p-outgroup [
    ;; Find turtles in ALL other groups
    let other-groups remove-item my-group group-agentsets
    
    ;; Pick a random out-group group, then pick a random member
    report one-of (one-of other-groups)
  ][
    ;; Instantly grab the pre-calculated in-group
    report one-of other (item my-group group-agentsets)
  ]
end

to-report should-cooperate? [agent signal]
  ;; 0: no inference
  if model-variant = 0 [report never-inference agent signal]
  
  ;; 1: mixed model (normal)
  if model-variant = 1 [report mixed-inference agent signal]
  
  ;; 2: always infer
  if model-variant = 2 [report always-inference agent signal]
end

to-report never-inference [agent signal]
  ;; Known partners are always cooperated with
  if member? agent known-partners [
    report true
  ]
  
  set stranger-partner stranger-partner + 1
  
  ;; Heuristic strategy only
  let p-in p-ingroup-est
  
  ;; Calculate EU of potential actions based strictly on priors
  let eu-coop (p-in * payoff) - ((1 - p-in) * penalty)
  let eu-defect ((1 - p-in) * payoff) - (p-in * penalty)
  
  let p-coop 1 / (1 + exp (- decision-steepness * (eu-coop - eu-defect)))
  report (random-float 1 < p-coop)
  
end
  
to-report mixed-inference [agent signal]
  ;; Known partners are always cooperated with
  if member? agent known-partners [
    report true
  ]
  
  set stranger-partner stranger-partner + 1
  
  ;; 2. Base Heuristic on Priors
  let p-in p-ingroup-est
  
  ;; Calculate EU of potential actions based strictly on priors
  let eu-coop-heu (p-in * payoff) - ((1 - p-in) * penalty)
  let eu-defect-heu ((1 - p-in) * payoff) - (p-in * penalty)
  
  ;; Heuristic Utility = best blind guess
  let eu-heuristic max (list eu-coop-heu eu-defect-heu)
  
  ;; 3. Expected Utility of Inference
  let expected-inference-payoff (payoff * risk-perception) + (eu-heuristic * (1 - risk-perception))
  let eu-inference expected-inference-payoff - inference-cost
  
  ;; 4. Strategy choice: Softmax / Logistic function
  let delta-eu-strategy (eu-inference - eu-heuristic)
  let p-inference 1 / (1 + exp (- decision-steepness * delta-eu-strategy))
  
  ;; 5. Execute chosen strategy
  ifelse (random-float 1 > p-inference) [
    ;; STRATEGY A: Heuristic
    
    ;; Logistic function
    let delta-eu-heu (eu-coop-heu - eu-defect-heu)
    let p-coop 1 / (1 + exp (- decision-steepness * delta-eu-heu))
    report (random-float 1 < p-coop)
  ][
    ;; STRATEGY B: Bayesian Inference
    set used-inference used-inference + 1 ;; Metric
    
    ;; Evaluate the signal
    let probs group-posterior signal
    let p-same item group-id probs
    
    let eu-coop-inf (p-same * payoff) - ((1 - p-same) * penalty)
    let eu-defect-inf ((1 - p-same) * payoff) - (p-same * penalty)
    
    let delta-eu-inf (eu-coop-inf - eu-defect-inf)
    let p-coop 1 / (1 + exp (- decision-steepness * delta-eu-inf))
    report (random-float 1 < p-coop)
  ]    
end

to-report always-inference [agent signal]
   ;; Known partners are always cooperated with
  if not member? agent known-partners [
    set stranger-partner stranger-partner + 1
  ]
  
  ;; Bayesian Inference only
  set used-inference used-inference + 1 ;; Metric
  
  ;; Evaluate the signal
  let probs group-posterior signal
  let p-same item group-id probs
  
  let eu-coop-inf (p-same * payoff) - ((1 - p-same) * penalty)
  let eu-defect-inf ((1 - p-same) * payoff) - (p-same * penalty)
  report (eu-coop-inf > eu-defect-inf) 
  
end

;; Payoffs for group discrimination
to apply-decision-outcomes [partner i-cooperated? same-group?]
  ;; In-group
  ifelse same-group? [
    ifelse i-cooperated? [  
      ;; Good outcome
      set coop-ingroup coop-ingroup + 1 ;; Metric
      set fitness fitness + payoff
    ][
      ;; Bad outcome
      set defect-ingroup defect-ingroup + 1 ;; Metric
      set fitness fitness - penalty
    ]
  ][
    ;; Out-group
    ifelse i-cooperated? [
      ;; Bad outcome 
      set coop-outgroup coop-outgroup + 1 ;; Metric
      set fitness fitness - penalty
    ][
      ;; Good outcome
      set defect-outgroup defect-outgroup + 1 ;; Metric
      set fitness fitness + payoff
    ]
  ]
end

;; Payoffs for accurate group membership signalling
to apply-partner-outcomes [partner-cooperated?]
  ifelse partner-cooperated? [
    set signal-success signal-success + 1 ;; Metric
    ;; Good outcome
    set fitness fitness + payoff
  ][
    ;; Bad outcome
    set fitness fitness - penalty
  ]
end

;; Interaction random copying
to diffuse-language [partner]
  if random-float 1 < diffusion-rate [

    let i random num-features

    let partner-variant [item i language] of partner

    set language replace-item i language partner-variant
  ]
end

to update-known-partners [partner]
  if count known-partners < social-memory-size [
    if [count known-partners] of partner < social-memory-size [
      ;; Add partner to known-partners
      set known-partners (turtle-set known-partners partner)
      ;; Ask partner to add me 
      ask partner [
        set known-partners (turtle-set known-partners myself)
      ]
    ]
  ]
end

to update-risk-perception
  let identity-ambiguity
    (1 - abs (p-ingroup-est - 0.5) * 2)

  set risk-perception
    (p-stranger-est * identity-ambiguity)
end

;;;;;;;;
;;;;;;;;;;;;;;;; Learning
;;;;;;;;

to update-stranger-prior [partner]
  ifelse member? partner known-partners [
    set beta-stranger beta-stranger + 1
  ][
    set alpha-stranger alpha-stranger + 1
  ]
  
  set p-stranger-est alpha-stranger / (alpha-stranger + beta-stranger)
  
  ;; Prevent probabilities reaching 0 or 1
  set p-stranger-est max list 0.0001 (min list 0.9999 p-stranger-est)
  set p-ingroup-est max list 0.0001 (min list 0.9999 p-ingroup-est)
end

to bayesian-update [partner-signal partner-group]  
  let f 0
  
  while [f < num-features] [
    let observed item f partner-signal
    let v-idx position observed variants
    let g partner-group
    
    let idx get-belief-index f v-idx g
    
    let current-belief array:item belief-counts idx
    
    array:set belief-counts idx (current-belief + 1)
    
    set f f + 1
  ]
end

to update-ingroup-prior [same-group? partner]
  if not member? partner known-partners [
    ifelse same-group? [
      set alpha-ingroup alpha-ingroup + 1
    ][
      set beta-ingroup beta-ingroup + 1
    ]
  ]
  
  set p-ingroup-est alpha-ingroup / (alpha-ingroup + beta-ingroup)
  
  ;; Prevent probabilities reaching 0 or 1
  if p-ingroup-est < 0.0001 [ set p-ingroup-est 0.0001 ]
  if p-ingroup-est > 0.9999 [ set p-ingroup-est 0.9999 ]
end

;;;;;;;;
;;;;;;;;;;;;;;;; Language updating (social learning)
;;;;;;;;

to run-social-learning
  let learners identify-learners

  ask learners [

    let model identify-model

    if model != nobody [

      set language [language] of model

      ;; Noise
      let i random num-features
      if random-float 1 < noise-rate [
        set language replace-item i language (one-of variants)
      ]
    ]
  ]
end


to-report identify-learners
  let count-learners round (pop-size * random-float social-learning-rate)
  
  report min-n-of count-learners turtles [fitness]
end

to-report identify-model
  let fitter one-of known-partners with [fitness > [fitness] of myself] 
  
  report fitter 
end

;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Metrics/reporters ;;;
;;;;;;;;;;;;;;;;;;;;;;;;;

to-report get-belief-index [f v-idx g]
  ;; f: feature index, v-idx: variant index, g: group ID
  report (f * num-variants * num-groups) + (v-idx * num-groups) + g
end

to-report get-count [f v-idx g]
  let idx get-belief-index f v-idx g
  report array:item belief-counts idx
end

to-report get-lang-count-index [g f v-idx]
  report (g * num-features * num-variants) + (f * num-variants) + v-idx
end

;; Coop-defect ratio
to-report coop-ratio
  if tick-interactions = 0 [report 0]
  report coop / tick-interactions
end

to-report success-ingroup
  let total (coop-ingroup + defect-ingroup)
  if total = 0 [ report 0 ]
  report coop-ingroup / total
end

to-report success-outgroup
  let total (coop-outgroup + defect-outgroup)
  if total = 0 [ report 0 ]
  report defect-outgroup / total
end

to-report success-overall
  let total (coop-ingroup + defect-ingroup + coop-outgroup + defect-outgroup)
  if total = 0 [ report 0 ]
  
  let successes (coop-ingroup + defect-outgroup)
  report successes / total
end

to-report signalling-success
  if tick-ingroup = 0 [report 0]
  report signal-success / tick-ingroup
end

to-report proportion-inference
  ;; Proportion of inference used where possible (i.e. with strangers)
  if stranger-partner = 0 [report 0]
  report used-inference / stranger-partner
end

;; Jensen–Shannon divergence between two groups
to-report js-divergence [g1 g2]
  let q group-language-distribution g1
  let r group-language-distribution g2

  ;; Midpoint distribution
  let m []
  let i 0

  while [i < length q] [
    set m lput ((item i q + item i r) / 2) m
    set i i + 1
  ]

  ;; Symmetric KL averaging
  report (kl q m + kl r m) / 2
end


;; Normalised JS divergence in [0,1]
to-report js-divergence-normalised [g1 g2]
  report (js-divergence g1 g2) / ln 2
end

;; Average pairwise divergence across all groups
to-report between-group-js
  let g1 0
  let sum-js 0
  let pairs 0

  while [g1 < num-groups] [
    let g2 (g1 + 1)

    while [g2 < num-groups] [
      set sum-js sum-js + js-divergence-normalised g1 g2
      set pairs pairs + 1

      set g2 g2 + 1
    ]

    set g1 g1 + 1
  ]

  if pairs = 0 [ report 0 ]

  report sum-js / pairs
end


;; Probability distribution of language variants within a group
to-report group-language-distribution [g]
  let dist n-values (num-features * num-variants) [ i ->
    array:item group-language-counts (get-lang-count-index g (floor (i / num-variants)) (i mod num-variants))
  ]
  
  let total sum dist
  if total = 0 [ report dist ]
  
  ;; Convert counts to probabilities
  report map [x -> x / total] dist
end


;; Kullback–Leibler divergence
to-report kl [q r]
  let terms (map [ [qi ri] -> 
    ifelse-value (qi > 0) [ qi * ln (qi / ri) ] [ 0 ]
  ] q r)
  
  report sum terms
end

;; Distribution for ONE feature within a group
to-report feature-distribution [g f]
  ;; Create a list by reading directly from the array
  let dist n-values num-variants [ v-idx -> array:item group-language-counts (get-lang-count-index g f v-idx) ]
  
  let total sum dist
  if total = 0 [ report dist ]
  
  ;; Convert to probabilities
  report map [x -> x / total] dist
end

;; JS divergence for a SINGLE feature
to-report feature-js-divergence [g1 g2 f]

  let q feature-distribution g1 f
  let r feature-distribution g2 f

  ;; Midpoint
  let m []
  let i 0

  while [i < length q] [
    set m lput ((item i q + item i r) / 2) m
    set i i + 1
  ]

  report ((kl q m + kl r m) / 2) / ln 2
end

;; List of JS divergences across features
to-report per-feature-js [g1 g2]

  let vals []
  let f 0

  while [f < num-features] [
    set vals lput (feature-js-divergence g1 g2 f) vals
    set f f + 1
  ]

  report vals
end

to-report min-feature-js [g1 g2]
  report min (per-feature-js g1 g2)
end

to-report max-feature-js [g1 g2]
  report max (per-feature-js g1 g2)
end

to-report median-feature-js [g1 g2]

  let vals sort (per-feature-js g1 g2)
  let n length vals

  if n = 0 [ report 0 ]

  if remainder n 2 = 1 [
    report item (floor (n / 2)) vals
  ]

  let upper item (n / 2) vals
  let lower item ((n / 2) - 1) vals

  report (lower + upper) / 2
end
to-report mean-risk-perception
  report mean [risk-perception] of turtles
end


;;;;;;;;
;;;;;;;;;;;;;;;; BehaviorSpace metrics
;;;;;;;;

to-report mean-final-n [ history-list n ]
  let len length history-list
  if len = 0 [ report 0 ] ;; Safety catch
  if len < n [ report mean history-list ]
  
  report mean sublist history-list (len - n) len
end

to-report mean-inference-final
  report mean-final-n inference-history 500
end

to-report mean-js-final
  report mean-final-n js-history 500
end

to-report mean-risk-perception-final
  report mean-final-n risk-perception-history 500
end

to-report mean-min-js-final
  report mean-final-n min-js-history 500
end

to-report mean-median-js-final
  report mean-final-n median-js-history 500
end

to-report mean-max-js-final
  report mean-final-n max-js-history 500
end


to update-language-counts  
  ;; 1. Fast reset: wipe the array back to 0
  let i 0
  let len array:length group-language-counts
  while [i < len] [
    array:set group-language-counts i 0
    set i i + 1
  ]
  
  ;; 2. Tally the new counts directly in-place
  ask turtles [
    let g group-id    
    let f 0 
    
    while [f < num-features] [
      let v item f language 
      let v-idx position v variants   
      
      ;; Find slot
      let idx get-lang-count-index g f v-idx
      
      ;; Read and increment in memory
      let current-count array:item group-language-counts idx
      array:set group-language-counts idx (current-count + 1)   
      
      set f f + 1 
    ]
  ]
end


;;;;;;;;;;;;;;;;;;;;;;
;;; Global helpers ;;;
;;;;;;;;;;;;;;;;;;;;;;

to-report new-belief-array
  let total-size (num-features * num-variants * num-groups)

  report array:from-list
    n-values total-size [1]
end

;;;;;;;;
;;;;;;;;;;;;;;;; Interaction helpers
;;;;;;;;

to-report feature-prob [f v-idx g]
  let total 0
  let i 0
  
  ;; Sum up the counts for all variants of this feature in this group
  while [i < num-variants] [
    set total total + (get-count f i g)
    set i i + 1
  ]

  if total = 0 [
    report 1 / num-variants
  ]

  ;; Return the specific variant count divided by the total
  report (get-count f v-idx g) / total
end


;; Group-log score
to-report log-group-posterior [signal g]
  let score 0
  
  ;; Add prior
  ifelse g = group-id [
    set score score + ln p-ingroup-est
  ][
    set score score + ln ((1 - p-ingroup-est) + 0.00001)
  ]

  let f 0
  while [f < num-features] [
    let v position (item f signal) variants
    let p feature-prob f v g

    if p = 0 [ set p 0.000001 ]
    set score score + ln p

    set f f + 1
  ]

  report score
end

;; Softmax over logscores
to-report group-posterior [signal]
  let scores n-values num-groups [ g -> log-group-posterior signal g ]
  let max-score max scores

  ;; Exp normalization
  let exp-scores map [s -> exp (s - max-score)] scores
  let total sum exp-scores

  report map [x -> x / total] exp-scores
end]]></code>
  <widgets>
    <view x="295" wrappingAllowedX="true" y="15" frameRate="30.0" minPycor="-16" height="79" showTickCounter="true" patchSize="2.3" fontSize="10" wrappingAllowedY="true" width="79" tickCounterLabel="ticks" maxPycor="16" updateMode="0" maxPxcor="16" minPxcor="-16"></view>
    <button x="80" y="15" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="55">go</button>
    <button x="145" y="15" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="61" display="go once">go</button>
    <slider x="15" step="0.01" y="185" max="1" width="250" display="p-outgroup" height="50" min="0" direction="Horizontal" default="0.5" variable="p-outgroup"></slider>
    <slider x="15" step="5" y="125" max="100" width="250" display="social-memory-size" height="50" min="0" direction="Horizontal" default="15.0" variable="social-memory-size"></slider>
    <button x="15" y="15" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55">setup</button>
    <plot x="400" autoPlotX="true" yMax="1.0" autoPlotY="true" y="15" xMin="0.0" height="130" legend="false" xMax="10.0" yMin="0.0" width="175" display="coop %">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="coops" color="-16777216" legend="true">
        <setup></setup>
        <update>plot coop-ratio</update>
      </pen>
    </plot>
    <plot x="400" autoPlotX="true" yMax="1.0" autoPlotY="true" y="350" xMin="0.0" height="120" legend="false" xMax="10.0" yMin="0.0" width="175" display="signalling success %">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update>plot signalling-success</update>
      </pen>
    </plot>
